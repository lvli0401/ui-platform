{
  "schemaVersion": "0.1.0",
  "id": "doc-login",
  "name": "Login Page",
  "revision": 0,
  "pages": [
    {
      "id": "page-login",
      "name": "Login",
      "root": {
        "id": "login-root",
        "type": "element",
        "tag": "div",
        "style": {
          "display": "flex",
          "justifyContent": "center",
          "alignItems": "center",
          "minHeight": "100vh",
          "backgroundColor": "#f3f4f6"
        },
        "children": [
          {
            "id": "login-card",
            "type": "component",
            "component": "Card",
            "style": {
              "display": "flex",
              "flexDirection": "column",
              "width": 360,
              "gap": 16,
              "padding": 32,
              "backgroundColor": "#ffffff",
              "borderRadius": 12
            },
            "children": [
              {
                "id": "login-title",
                "type": "component",
                "component": "Text",
                "props": {
                  "text": "Sign in",
                  "as": "h1"
                },
                "style": {
                  "fontSize": 24,
                  "fontWeight": 600,
                  "color": "#111827"
                }
              },
              {
                "id": "username",
                "type": "component",
                "component": "Input",
                "props": {
                  "placeholder": "用户名",
                  "type": "text",
                  "value": "",
                  "disabled": false
                },
                "style": {
                  "width": "100%"
                }
              },
              {
                "id": "password",
                "type": "component",
                "component": "Input",
                "props": {
                  "placeholder": "密码",
                  "type": "password",
                  "value": "",
                  "disabled": false
                },
                "style": {
                  "width": "100%"
                }
              },
              {
                "id": "submit",
                "type": "component",
                "component": "Button",
                "props": {
                  "label": "登录",
                  "variant": "primary",
                  "disabled": false
                },
                "style": {
                  "width": "100%"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
